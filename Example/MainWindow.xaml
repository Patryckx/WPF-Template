<Window x:Class="Example.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Example" xmlns:viewmodels="clr-namespace:Example.ViewModels"
        
        
        xmlns:controls="clr-namespace:Example.Controls"
        xmlns:models="clr-namespace:Example.Models"
        
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        
        Title="Example" Height="700" Width="1100" 
        WindowStartupLocation="CenterScreen" 
        ResizeMode="CanResize" WindowState="Normal" MinWidth="1024" MinHeight="640">

    <!-- ========================================= -->
    <!-- LAYOUT PRINCIPAL                         -->
    <!-- ========================================= -->

    <Grid x:Name="MainGrid">

        <Grid.RowDefinitions>
            <!--Main & Sidebar -->
            <RowDefinition Height="*"/>
            <!--Status Bar -->
            <RowDefinition Height="10"/>

        </Grid.RowDefinitions>
        <!-- ========================================= -->
        <!-- MAIN & SIDEBAR                                -->
        <!-- ========================================= -->
        <Grid Grid.Row="0" x:Name="Sidebar_and_Main">
            <Grid.ColumnDefinitions>
                <!--Sidebar -->
                <ColumnDefinition Width="  230"/>
                <!--Main -->
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>
            <!-- ========================================= -->
            <!--  SIDEBAR                                 -->
            <!-- ========================================= -->
            <Border Background="{StaticResource Brush.Header2}"
                    Padding="5" HorizontalAlignment="Center" >
                <Grid Grid.Column="0" x:Name="Sidebar" Margin="15">
                
                    <Grid.RowDefinitions>
                        <!--Logo-->
                        <RowDefinition Height=".35*"/>
                        <RowDefinition Height=".9*"/>
                        <!--Buttons-->
                        <RowDefinition Height="230"/>

                    </Grid.RowDefinitions>
                    
                    <!-- 1.- LOGO -->

                    <Image Grid.Row="0"
                           Source="/Resources/Images/Nidec_logo_green.png"
                           Stretch="Uniform"/>


                    <!-- 2.- PROCESS INFO -->

                    <Grid Grid.Row="1">

                        <Grid.RowDefinitions>   
                            
                            <!--Sequence title-->
                            <RowDefinition Height="*"/>
                            <!--Step 1-->
                            <RowDefinition Height="*"/>
                            <!--Step 2-->
                            <RowDefinition Height="*"/>
                            <!--Step 3-->
                            <RowDefinition Height="*"/>
                            <!--Step 4-->
                            <RowDefinition Height="*"/>
                            <!--Step 5-->
                            <RowDefinition Height="*"/>
                            <!--Step 6-->
                            <RowDefinition Height="10"/>


                        </Grid.RowDefinitions>
                        
                        <!--Sequence title-->

                        <TextBlock
                                Grid.Row="0"
                                   Style="{StaticResource Text.H1}"
                                   Text="Pruebas"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="20,0,0,0"
                                   FontSize="32"/>


                        <controls:ProcessIndicator 
                            Grid.Row="1"
                            
                            Text="1"
                            FontSize="24"
                            Status="{Binding AppState.DCVoltageStatus}"
                            Width="140"
                            Height="auto"
                            Padding="0"/>

                        <controls:ProcessIndicator
                            Grid.Row="2"
                            Text="2"
                            FontSize="24"
                            Status="{Binding AppState.ResistanceTestStatus}"
                            Width="140"
                            Height="auto"
                            Padding="0"/>

                        <controls:ProcessIndicator
                            Grid.Row="3"
                            Text="3"
                            FontSize="24"
                            Status="{Binding AppState.LCDVisionTestStatus}"
                            Width="140"
                            Height="auto"
                            Padding="0"/>

                        <controls:ProcessIndicator
                            Grid.Row="4"
                            Text="4"
                            FontSize="24"
                            Status="{Binding ThirdStep}"
                            Width="140"
                            Height="auto"
                            Padding="0"/>

                        <controls:ProcessIndicator
                            Grid.Row="5"
                            Text="5"
                            FontSize="24"
                            Status="{Binding ThirdStep}"
                            Width="140"
                            Height="auto"
                            Padding="0"/>


                    </Grid>
                    
                    


                    <!-- 3.- BUTTONS-->
                    <Grid Grid.Row="2" >

                        <Grid.RowDefinitions>
                            <!-- BUTTON 1-->
                            <RowDefinition Height="*"/>
                            <!-- BUTTON 2-->
                            <RowDefinition Height="*"/>
                            <!-- BUTTON 3-->
                            <RowDefinition Height="*"/>
                            <!-- BUTTON 3-->
                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" 
                                Style="{StaticResource SidebarMenuStyleButton}"
                                Command="{Binding ShowInicializeScreenCommand}">

                            <StackPanel Orientation="Horizontal">

                                <Image Source="/Resources/Images/home.png"
                                       Width="32"
                                       Height="32"
                                       Margin="10,0,10,0"/>
                                
                                <TextBlock Text="Inicio"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" FontSize="28"/>


                            </StackPanel>

                        </Button>

                        <Button Grid.Row="1"
                                Style="{StaticResource SidebarMenuStyleButton}"
                                Command="{Binding ShowconfigurationScreenCommand}" Cursor="Hand" >

                            <StackPanel Orientation="Horizontal">

                                <Image Source="/Resources/Images/cogwheel.png"
                                       Width="32"
                                       Height="32"
                                       Margin="10,0,10,0"/>
                                <TextBlock Text="Configuración"
                                           VerticalAlignment="Center" FontSize="20"/>

                            </StackPanel>

                        </Button>

                        <Button Grid.Row="2"
                            Style="{StaticResource SidebarMenuStyleButton}"
                            Command="{Binding ShowSecondScreenCommand}">

                            <StackPanel Orientation="Horizontal">

                                <Image Source="/Resources/Images/folder.png"
                                    Width="32"
                                    Height="32"
                                    Margin="10,0,10,0"/>

                                <TextBlock Text="Trazabilidad"
                                       VerticalAlignment="Center" FontSize="24"/>


                            </StackPanel>


                        </Button>

                        <Button Grid.Row="3"
                                Style="{StaticResource SidebarMenuStyleButton}"
                                Command="{Binding ShowSecondScreenCommand}">

                            <StackPanel Orientation="Horizontal">

                                <Image Source="/Resources/Images/logout.png"
                                       Width="32"
                                       Height="32"
                                       Margin="10,0,10,0"/>

                                <TextBlock Text="Cerrar sesión"
                                           VerticalAlignment="Center" FontSize="20"/>


                            </StackPanel>
                            
                            
                        </Button>
                                


                    </Grid>
                    
                    


                </Grid>
            </Border>

            <!-- ========================================= -->
            <!--  MAIN AND HEADER                          -->
            <!-- ========================================= -->
            <Grid Grid.Column="1" x:Name="Main_and_Header">
                <Grid.RowDefinitions>
                    <!--Header -->
                    <RowDefinition Height="80"/>
                    <!--Main -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- ========================================= -->
                <!--            HEADER                         -->
                <!-- ========================================= -->

                <Grid Grid.Row="0">

                    <Border Background="{StaticResource Brush.Header}">
                        <Grid >

                            <Grid.ColumnDefinitions>
                                <!--Title -->
                                <ColumnDefinition Width="*"/>
                                <!--Indicators-->
                                <ColumnDefinition Width="*"/>
                                <!--Window functions -->
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <!--Title -->

                            <Grid Grid.Column="0">
                                
                            </Grid>
                            
                            <!--Indicators -->

                            <Grid Grid.Column="1">

                            </Grid>
                            <!--Window functions -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <!--Buttons -->
                                    <RowDefinition Height="*"/>
                                    <!--Unused space -->
                                    <RowDefinition Height=".8*"/>

                                </Grid.RowDefinitions>
                                <!--Buttons -->
                                <Grid Grid.Row="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!--Minimize -->
                                            <ColumnDefinition Width="*"/>
                                            
                                            <!--Maximize -->

                                            <ColumnDefinition Width="*"/>

                                            <!--Close -->

                                            <ColumnDefinition Width="*"/>

                                        </Grid.ColumnDefinitions>

                                        <!--Minimize -->
                                        <Button Grid.Column="0" 
                                                Width="auto"
                                                Height="auto"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Cursor="Hand"
                                                Margin="0 7 0 0"
                                                ToolTip="Minimizar"
                                                Command="{Binding MinimizeCommand}">

                                            <Image Source="/Resources/Images/minimize.png"
                                                   Stretch="Uniform">
                                                
                                            </Image>
                                           
                                            
                                        </Button>
                                        <!--Maximize -->
                                        <Button Grid.Column="1"
                                                Width="auto"
                                                Height="auto"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Cursor="Hand"
                                                Margin="0 7 0 0"
                                                ToolTip="Maximizar pantalla"
                                                Command="{Binding MaximizeCommand}">

                                            <Image Source="/Resources/Images/maximize.png"
                                                   Stretch="Uniform"/>

                                        </Button>
                                        <!--Close -->
                                        <Button Grid.Column="2"
                                                Width="auto"
                                                Height="auto"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Cursor="Hand"
                                                Margin="0 7 0 0"
                                                ToolTip="Cerrar aplicación"
                                                Command="{Binding CloseCommand}">

                                            <Image Source="/Resources/Images/cerrar2.png"
                                                   Stretch="Uniform"/>


                                        </Button>

                                    </Grid>
                                    
                                </Grid>
                                
                            </Grid>
                        </Grid>
                        
                    </Border>
                    
                </Grid>

                <!-- ========================================= -->
                <!--            MAIN SECTION                   -->
                <!-- ========================================= -->

                <Grid Grid.Row="1">

                    <ContentControl Content="{Binding CurrentView}"/>


                </Grid>

            </Grid>

        </Grid>
        
        <!-- ========================================= -->
        <!-- STATUS BAR                               -->
        <!-- ========================================= -->

        <Grid Grid.Row="1" x:Name="StatusBar" >

            <Border Background="{Binding AppState.AppGeneralStatus,
                             Converter={StaticResource StatusBrushConverter}}"/>
                
         
            
        </Grid>

    </Grid>
   
</Window>
