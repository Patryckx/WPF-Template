<Window x:Class="Example.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Example" xmlns:viewmodels="clr-namespace:Example.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        
        Title="Example" Height="700" Width="1100" 
        WindowStartupLocation="CenterScreen" 
        ResizeMode="CanResize" WindowState="Normal">

    <!-- ========================================= -->
    <!-- LAYOUT PRINCIPAL                         -->
    <!-- ========================================= -->

    <Grid x:Name="MainGrid">

        <Grid.RowDefinitions>
            <!--Main & Sidebar -->
            <RowDefinition Height="*"/>
            <!--Status Bar -->
            <RowDefinition Height="15"/>

        </Grid.RowDefinitions>


        <!-- ========================================= -->
        <!-- MAIN & SIDEBAR                                -->
        <!-- ========================================= -->
        <Grid Grid.Row="0" x:Name="Sidebar_and_Main">
            <Grid.ColumnDefinitions>
                <!--Sidebar -->
                <ColumnDefinition Width="1*"/>
                <!--Main -->
                <ColumnDefinition Width="4*"/>

            </Grid.ColumnDefinitions>

            <!-- ========================================= -->
            <!--  SIDEBAR                                 -->
            <!-- ========================================= -->
            <Border Background="{StaticResource Brush.Sidebar}">
                <Grid Grid.Column="0" x:Name="Sidebar">
                
                    <Grid.RowDefinitions>
                        <!--Logo-->
                        <RowDefinition Height="1*"/>
                        <!--Buttons-->
                        <RowDefinition Height="4*"/>

                    </Grid.RowDefinitions>


                </Grid>
            </Border>

            <!-- ========================================= -->
            <!--  MAIN AND HEADER                          -->
            <!-- ========================================= -->
            <Grid Grid.Column="1" x:Name="Main_and_Header">
                <Grid.RowDefinitions>
                    <!--Header -->
                    <RowDefinition Height="120"/>
                    <!--Main -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- ========================================= -->
                <!--            HEADER                         -->
                <!-- ========================================= -->

                <Grid Grid.Row="0">

                    <Border Background="{StaticResource Brush.Header}">
                        <Grid >

                            <Grid.ColumnDefinitions>
                                <!--Title -->
                                <ColumnDefinition Width="*"/>
                                <!--Indicators-->
                                <ColumnDefinition Width="*"/>
                                <!--Window functions -->
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <!--Title -->

                            <Grid Grid.Column="0">
                                
                            </Grid>
                            
                            <!--Indicators -->

                            <Grid Grid.Column="1">

                            </Grid>
                            <!--Window functions -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <!--Buttons -->
                                    <RowDefinition Height="*"/>
                                    <!--Unused space -->
                                    <RowDefinition Height="*"/>

                                </Grid.RowDefinitions>
                                <!--Buttons -->
                                <Grid Grid.Row="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!--Minimize -->
                                            <ColumnDefinition Width="*"/>
                                            
                                            <!--Maximize -->

                                            <ColumnDefinition Width="*"/>

                                            <!--Close -->

                                            <ColumnDefinition Width="*"/>

                                        </Grid.ColumnDefinitions>

                                        <!--Minimize -->
                                        <Button Grid.Column="0" 
                                                Width="40"
                                                Height="40"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Cursor="Hand"
                                                Margin="5"
                                                ToolTip="Minimizar"
                                                Command="{Binding MinimizeCommand}">

                                            <Image Source="/Resources/Images/minimize.png"
                                                   Stretch="Uniform">
                                                
                                            </Image>
                                           
                                            
                                        </Button>
                                        <!--Maximize -->
                                        <Button Grid.Column="1"
                                                Width="40"
                                                Height="40"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Cursor="Hand"
                                                Margin="5"
                                                ToolTip="Maximizar pantalla"
                                                Command="{Binding MaximizeCommand}">

                                            <Image Source="/Resources/Images/maximize.png"
                                                   Stretch="Uniform"/>

                                        </Button>
                                        <!--Close -->
                                        <Button Grid.Column="2"
                                                Width="40"
                                                Height="40"
                                                BorderThickness="0"
                                                Padding="0"
                                                Cursor="Hand"
                                                Margin="5"
                                                ToolTip="Cerrar aplicación"
                                                Command="{Binding CloseCommand}">

                                            <Image Source="/Resources/Images/close.png"
                                                   Stretch="Uniform"/>


                                        </Button>

                                    </Grid>
                                    
                                </Grid>
                                
                            </Grid>
                        </Grid>
                        
                    </Border>
                    
                </Grid>

                <!-- ========================================= -->
                <!--            MAIN SECTION                   -->
                <!-- ========================================= -->

                <Grid Grid.Row="1">

                    <ContentControl Content="{Binding CurrentView}"/>


                </Grid>

            </Grid>

        </Grid>
        
        <!-- ========================================= -->
        <!-- STATUS BAR                               -->
        <!-- ========================================= -->

        <Grid Grid.Row="1" x:Name="StatusBar" >

            <Border Background="Gray">
                
            </Border>
            
        </Grid>

    </Grid>
   
</Window>
