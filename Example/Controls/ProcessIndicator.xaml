<UserControl x:Class="Example.Controls.ProcessIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Example.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border x:Name="IndicatorBorder"
            Background="#303030"
            
            BorderBrush="White"
            BorderThickness="2"
            CornerRadius="10"
            Padding="2"
            Margin="5">


        <TextBlock Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="White"
                   
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>


    </Border>
</UserControl>
