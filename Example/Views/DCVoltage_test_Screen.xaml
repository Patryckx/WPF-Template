<UserControl x:Class="Example.Views.DCVoltage_test_Screen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Example.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>
        <!--Title-->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="7*"/>
            </Grid.ColumnDefinitions>

            <!--Icon-->

            <Grid Grid.Column="0">
                <Image Source="/Resources/Images/number-1 (1).png" Width="auto" Height="auto" Margin="5" >
                </Image>
            </Grid>
            
            <!--Test Title-->

            <Grid Grid.Column="1">
                <TextBlock
                   FontSize="40"
                   FontWeight="Bold"
                   FontFamily="Segoe UI"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"><Run Language="es-mx" Text="Prueba de voltaje"/>
                </TextBlock>

            </Grid>

        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            
            <!--TEST INFORMATION-->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="*"/>
                    
                </Grid.RowDefinitions>
                <!--Information-->
                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Image Source="/Resources/Images/informacion.png" Width="auto" Height="auto" Margin="10" >
                        </Image>
                    </Grid>

                    <Grid Grid.Column="1">
                        <TextBlock
                            FontSize="36"
                            FontWeight="Bold"
                            FontFamily="Segoe UI"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"><Run Language="es-mx" Text="Información"/>
                        </TextBlock>

                    </Grid>

                    
                </Grid>

                <Grid Grid.Row="1">


                    <TextBlock
                        FontSize="24"
                        FontWeight="Regular"
                        Margin="10"
                        FontFamily="Segoe UI"
                        TextWrapping="WrapWithOverflow"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"><Run Language="es-mx"
                        Text="Realizando prueba de voltaje directo por favor, 
                        posicione las terminales 
                        en la PCB y pulse el botón 
                                                        para realizar la prueba  "/>
                    </TextBlock>
                </Grid>


                <Grid Grid.Row="2" Margin="10 10 20 20">
                    <Button
                        Style="{StaticResource ModernButton}"
                        Content="Medir voltaje DC"
                        FontSize="24"
                        FontWeight="Bold"
                        BorderBrush="DarkGreen"
                        Background="{StaticResource Brush.Header2}"
                        Command="{Binding DC_Voltage_Meassure_Command}"/>
                    
                </Grid>


            </Grid>
            
            <!--RESULTS-->

            <Grid Grid.Column="1" Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>

                <!--Aqui iria el stacked widget-->
                <!--LIMITES-->
                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <!--Limite inferior-->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <!--Title-->

                        <Grid Grid.Row="0">
                            <TextBlock
                            FontSize="24"
                            FontWeight="Bold"
                            Margin="10"
                            Foreground="DarkCyan"
                            FontFamily="Segoe UI"
                            HorizontalAlignment="center"
                            VerticalAlignment="Center"><Run Language="es-mx"
                            Text="Limite inferior"/>
                            </TextBlock>

                        </Grid>

                        <Grid Grid.Row="1">
                            <TextBlock
                            FontSize="24"
                            FontWeight="Bold"
                            Margin="10"
                            Text="{Binding DC_voltage_test_lower_limit}" 
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            FontFamily="Arial"
                            />              
                        </Grid>

                    </Grid>

                    <!--Limite superior-->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock
                        FontSize="24"
                        FontWeight="Bold"
                        Margin="10"
                        Foreground="DarkCyan"
                        FontFamily="Segoe UI"
                        HorizontalAlignment="center"
                        VerticalAlignment="Center"><Run Language="es-mx"
                        Text="Limite superior"/>
                            </TextBlock>

                        </Grid>

                        <Grid Grid.Row="1">
                            <TextBlock
                            FontSize="24"
                            FontWeight="Bold"
                            Margin="10"
                            Text="{Binding DC_voltage_test_upper_limit}" 
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            FontFamily="Arial"
                            />      
                        </Grid>



                    </Grid>

                </Grid>

                <Grid Grid.Row="1">
                    <!--VOLTAGE VALUE-->

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">

                        <TextBlock
                        FontSize="24"
                        FontWeight="Bold"
                        Margin="10"
                        Foreground="DarkGreen"
                        FontFamily="Segoe UI"
                        HorizontalAlignment="center"
                        VerticalAlignment="Center"><Run Language="es-mx"
                        Text="Ultima medida obtenida VDC "/>
                        </TextBlock>

                    </Grid>

                    <Grid Grid.Row="1">
                        <TextBlock
                            FontSize="24"
                            FontWeight="Bold"
                            Margin="10"
                            Text="{Binding LastDCVoltageMeassure}" 
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            FontFamily="Arial"
                            />              
                    </Grid>

                </Grid>


                 

                <Grid Grid.Row="2">

                    <!-- WAITING -->

                    <Image
                            Source="/Resources/Images/dc_test_wait_visual_help.png"
                            Stretch="Uniform">

                        <Image.Style>

                            <Style TargetType="Image">

                                <Setter
                                    Property="Visibility"
                                    Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger
                                        Binding="{Binding CurrentTestState}"
                                        Value="Waiting">

                                        <Setter
                                            Property="Visibility"
                                            Value="Visible"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Image.Style>

                    </Image>


                    <!-- MEASURING -->

                    <Image
                        Source="/Resources/Images/dc_test_pass_visual_help.png"
                        Stretch="Uniform">

                        <Image.Style>

                            <Style TargetType="Image">

                                <Setter
                                    Property="Visibility"
                                    Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger
                                        Binding="{Binding CurrentTestState}"
                                        Value="Measuring">

                                        <Setter
                                        Property="Visibility"
                                        Value="Visible"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Image.Style>

                    </Image>


                    <!-- SUCCESS -->

                    <Image
                        Source="/Resources/Images/dc_test_pass_visual_help.png"
                        Stretch="Uniform">

                        <Image.Style>

                            <Style TargetType="Image">

                                <Setter
                                    Property="Visibility"
                                    Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger
                                        Binding="{Binding CurrentTestState}"
                                        Value="Success">

                                        <Setter
                                            Property="Visibility"
                                            Value="Visible"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Image.Style>

                    </Image>


                    <!-- FAILED -->

                    <Image
                        Source="/Resources/Images/dc_test_fail_visual_help.png"
                        Stretch="Uniform">

                        <Image.Style>

                            <Style TargetType="Image">

                                <Setter
                        Property="Visibility"
                        Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger
                        Binding="{Binding CurrentTestState}"
                        Value="Failed">

                                        <Setter
                            Property="Visibility"
                            Value="Visible"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Image.Style>

                    </Image>


                </Grid>

            </Grid>

            
            
        </Grid>
            
    </Grid>
</UserControl>
