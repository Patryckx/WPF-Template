<UserControl x:Class="Example.Views.ConfigurationScreenEdit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Example.Views"
             
             d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
             
             xmlns:viewmodels="clr-namespace:Example.ViewModels"
             xmlns:controls="clr-namespace:Example.Controls"
             xmlns:models="clr-namespace:Example.Models"
             mc:Ignorable="d" 
             
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White" Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>


        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>

            </Grid.ColumnDefinitions>

            <!--Icon-->

            <Grid Grid.Column="0">
                <Image Source="/Resources/Images/cogwheel.png" Width="auto" Height="auto" Margin="10" >
                </Image>
            </Grid>

            <!--Title-->

            <Grid Grid.Column="1">
                <TextBlock
               FontSize="40"
               FontWeight="Bold"
               FontFamily="Segoe UI"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"><Run Language="es-mx" Text="Configuración"/>
                </TextBlock>
            </Grid>

            <Grid Grid.Column="2">
                <Button   
                        Command="{Binding DataContext.ShowconfigurationScreenCommand,
                         RelativeSource={RelativeSource AncestorType=Window}}"
        
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Editar">
                                    <Image Source="/Resources/Images/undo.png" Width="auto" Height="auto"
                        Margin="10"  />
                </Button>
            </Grid>

            <Grid Grid.Column="3">
                <Button   
                    Command="{Binding SaveCommand }"
        
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="Editar">
                                <Image Source="/Resources/Images/diskette.png" Width="auto" Height="auto"
                    Margin="10"  />
                </Button>
            </Grid>







        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Image Source="/Resources/Images/circuito.png"></Image>
                </Grid>

                <Grid Grid.Column="1">
                    <TextBlock HorizontalAlignment="left" FontWeight="Bold" 
                           FontSize="36" VerticalAlignment="Center" Text="Gateway" Margin="10"></TextBlock>
                </Grid>

            </Grid>

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!--ICON-->

                <Grid Grid.Column="0">
                    <Image Source="/Resources/Images/microchip.png" Margin="10"></Image>
                </Grid>

                <!--title (direccion ip) -->

                <Grid Grid.Column="1">
                    <TextBlock
                   FontSize="32"

                   FontWeight="Light"
                   FontFamily="Arial"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"><Run Language="es-mx" Text="Dirección IP"/></TextBlock>
                </Grid>

                <!--TEXTBOX-->

                <Grid Grid.Column="2">
                    <TextBox Name="txtDireccionIp" HorizontalAlignment="Left" 
                         Height="auto" Width="350" BorderBrush="Gray" 
                         Margin="5" FontFamily="Arial" FontSize="28"
                        FontStyle="Normal" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" >


                    </TextBox>

                </Grid>

            </Grid>


            <!--TEXTBLOCK-->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>


                <Grid Grid.Column="0">

                    <Image Source="/Resources/Images/local-area-network.png" Margin="10"></Image>
                </Grid>



                <!--TITLE-->
                <Grid Grid.Column="1">
                    <TextBlock
                   FontSize="32"

                   FontWeight="light"
                   FontFamily="Arial"
                   HorizontalAlignment="center"
                   VerticalAlignment="Center"><Run Language="es-mx" Text="Puerto"/></TextBlock>
                </Grid>
                <!--TEXTBOX-->

                <Grid Grid.Column="2">
                    <TextBox Name="txtPuerto" HorizontalAlignment="Left" 
                         Height="auto" Width="350" 
                         BorderBrush="Gray" Margin="5"
                         FontFamily="Arial" FontSize="28"
                         FontStyle="Normal" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         >

                    </TextBox>

                </Grid>
            </Grid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!--Icon-->

                <Grid Grid.Column="0">

                    <Image Source="/Resources/Images/database.png" Margin="10"></Image>
                </Grid>

                <!--TITLE-->

                <Grid Grid.Column="1">
                    <TextBlock
                   FontSize="36"

                   FontWeight="Bold"
                   FontFamily="Arial"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"><Run Language="es-mx" Text="Base de datos" />
                    </TextBlock>
                </Grid>

            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!--ICON-->

                <Grid Grid.Column="0">
                    <Image Source="/Resources/Images/local-area-network.png" Margin="10"></Image>
                </Grid>

                <!--ICON-->

                <Grid Grid.Column="1">

                    <TextBlock
                   FontSize="32"

                   FontWeight="Light"
                   FontFamily="Arial"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center" Margin="0,0,34,0"><Run Language="es-mx" Text="Dirección IP"/></TextBlock>


                </Grid>

                <Grid Grid.Column="2">
                    <TextBox Name="TxtdireccionBD" HorizontalAlignment="Left" 
                         Height="auto" Width="350" 
                         BorderBrush="Gray" Margin="5"
                         FontFamily="Arial" FontSize="28"
                        FontStyle="Normal" Text="{Binding DatabaseAddress, UpdateSourceTrigger=PropertyChanged}">

                    </TextBox>
                </Grid>

            </Grid>

        </Grid>
    </Grid>
</UserControl>
