<UserControl x:Class="Example.Views.SecondScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Example.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>


        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!--ICON-->
            <Grid Grid.Column="0">
                <Image Source="/Resources/Images/folder.png" Width="auto" Height="auto" Margin="5"></Image>
            </Grid>

            <!--TITLE-->
            <Grid Grid.Column="1">
                <TextBlock Text="Trazabilidad" HorizontalAlignment="left" 
                           VerticalAlignment="Center" FontSize="36" FontWeight="Bold"
                           Margin="10 0 0 0"/>

            </Grid>
            
            
            
            
        </Grid>

        <Grid Grid.Row="1" Margin="10">

            <DataGrid
                x:Name="TraceabilityTable" 
                AutoGenerateColumns="True" 
                IsReadOnly="True">
                
            </DataGrid>
        </Grid>
        
        
        

    </Grid>
</UserControl>
