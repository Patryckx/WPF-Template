<UserControl x:Class="Example.Views.ConfigurationScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Example.Views"
             xmlns:viewmodels="clr-namespace:Example.ViewModels"
             xmlns:controls="clr-namespace:Example.Controls"
             xmlns:models="clr-namespace:Example.Models"
             mc:Ignorable="d" 
             
             
             
             d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
             
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White" Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>


        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>

            </Grid.ColumnDefinitions>

            <!--Icon-->

            <Grid Grid.Column="0">
                <Image Source="/Resources/Images/cogwheel.png" Width="auto" Height="auto" Margin="5" >
                </Image>
            </Grid>

            <!--Title-->

            <Grid Grid.Column="1">
                <TextBlock
                   FontSize="40"
                   FontWeight="Bold"
                   FontFamily="Segoe UI"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"><Run Language="es-mx" Text="Configuración"/>
                </TextBlock>
            </Grid>

            <Grid Grid.Column="2">

                 <!--Command="{Binding ShowConfigurationEditScreenCommand}"-->
                     <Button   
                        Command="{Binding DataContext.ShowConfigScreenCommand,
                         RelativeSource={RelativeSource AncestorType=Window}}"
                        
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Editar" >
                    <Image Source="/Resources/Images/edit.png" Width="auto" Height="auto"
                        Margin="10"  />
                </Button>
                
            </Grid>







        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Image Source="/Resources/Images/circuito.png"></Image>
                </Grid>

                <Grid Grid.Column="1">
                    <TextBlock HorizontalAlignment="left" FontWeight="Bold" 
                               FontSize="32" Text="Gateway" VerticalAlignment="Center" ></TextBlock>
                </Grid>

            </Grid>

            

            <!--TEXTBLOCK-->

            <Grid Grid.Row="1" Margin="50 0 0 0 ">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>


                <Grid Grid.Column="0">

                    <Image Source="/Resources/Images/local-area-network.png"></Image>
                </Grid>
                <!--TITLE-->
                <Grid Grid.Column="1">
                    <TextBlock
                       FontSize="28"
    
                       FontWeight="light"
                       FontFamily="Arial"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"><Run Language="es-mx" Text="Dirección IP"/></TextBlock>
                </Grid>
                <!--TEXTBOX-->

                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84*"/>
                        <ColumnDefinition Width="67*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Name="lblPuerto" HorizontalAlignment="Center" 
                             Height="auto" Width="350" 
                              Margin="10,10,0,10"
                             FontFamily="Arial" FontSize="24"
                             FontStyle="Normal" Grid.ColumnSpan="2"
                               Text="{Binding Puerto}">
                    </TextBlock>

                </Grid>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!--Icon-->

                <Grid Grid.Column="0">

                    <Image Source="/Resources/Images/database.png"></Image>
                </Grid>

                <!--TITLE-->

                <Grid Grid.Column="1">
                    <TextBlock
                       FontSize="32"
    
                       FontWeight="Bold"
                       FontFamily="Arial"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"><Run Language="es-mx" Text="Base de datos" />
                    </TextBlock>
                </Grid>

            </Grid>

            <Grid Grid.Row="3" Margin="50 0 0 0 ">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!--ICON-->

                <Grid Grid.Column="0">
                    <Image Source="/Resources/Images/local-area-network.png" ></Image>
                </Grid>

                <!--ICON-->

                <Grid Grid.Column="1">

                    <TextBlock
                       FontSize="28"
    
                       FontWeight="Light"
                       FontFamily="Arial"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="0,0,34,0"><Run Language="es-mx" Text="Dirección IP"/></TextBlock>


                </Grid>

                <Grid Grid.Column="2">
                    <TextBlock Name="lblDireccionBD" HorizontalAlignment="center" 
                             Height="auto" Width="350" 
                             FontFamily="Arial" FontSize="28"
                            FontStyle="Normal"
                               Text="{Binding DireccionBD}">
                    </TextBlock>
                </Grid>

            </Grid>


            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Image Source="/Resources/Images/multimetro.png"></Image>
                </Grid>

                <Grid Grid.Column="1">
                    <TextBlock HorizontalAlignment="left" FontWeight="Bold" 
                               FontSize="32" Text="Multímetro" VerticalAlignment="Center" ></TextBlock>
                </Grid>

            </Grid>

            <Grid Grid.Row="5" Margin="50 0 0 0 ">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!--ICON-->

                <Grid Grid.Column="0">
                    <Image Source="/Resources/Images/usb.png" ></Image>
                </Grid>

                <!--ICON-->

                <Grid Grid.Column="1">

                    <TextBlock
                       FontSize="28"
    
                       FontWeight="Light"
                       FontFamily="Arial"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="0,0,34,0"><Run Language="es-mx" Text="Puerto serial"/></TextBlock>


                </Grid>

                <Grid Grid.Column="2">
                    <TextBlock Name="lblPuertoMultimetro" HorizontalAlignment="center" 
                 Height="auto" Width="350" 
                 FontFamily="Arial" FontSize="28"
                FontStyle="Normal"
                   Text="{Binding DireccionBD}">
                    </TextBlock>
                </Grid>

            </Grid>



            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Image Source="/Resources/Images/webcam.png"></Image>
                </Grid>

                <Grid Grid.Column="1">
                    <TextBlock HorizontalAlignment="left" FontWeight="Bold" 
                   FontSize="32" Text="Sistema de visión" VerticalAlignment="Center" ></TextBlock>
                </Grid>

            </Grid>

            <Grid Grid.Row="7" Margin="50 0 0 0 ">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!--ICON-->

                <Grid Grid.Column="0">
                    <Image Source="/Resources/Images/local-area-network.png" ></Image>
                </Grid>

                <!--ICON-->

                <Grid Grid.Column="1" >

                    <TextBlock
           FontSize="28"
    
           FontWeight="Light"
           FontFamily="Arial"
           HorizontalAlignment="Right"
           VerticalAlignment="Center" Margin="0,0,34,0"><Run Language="es-mx" Text="Dirección IP"/></TextBlock>


                </Grid>

                <Grid Grid.Column="2">
                    <TextBlock Name="lbldireccionCamaraVision" HorizontalAlignment="center" 
                     Height="auto" Width="350" 
                     FontFamily="Arial" FontSize="28"
                    FontStyle="Normal"
                       Text="{Binding DireccionBD}">
                    </TextBlock>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</UserControl>
