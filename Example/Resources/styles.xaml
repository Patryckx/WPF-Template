<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================= -->
    <!-- COLORS                                    -->
    <!-- ========================================= -->
    <Color x:Key="Color.Sidebar">#0AA547</Color>
    
    <Color x:Key="Color.Header_background" >#2f2f2f</Color>
    <Color x:Key="Color.Header2_background" >#02954A</Color>

    <Color x:Key="Color.Button_sidebar_pressed" >#01582B</Color>

    <Color x:Key="Color.Success">#2ECC71</Color>
    <Color x:Key="Color.Danger">#E74C3C</Color>

    <Color x:Key="Color.Text">#FFFFFF</Color>
    <Color x:Key="Color.TextSecondary">#AAAAAA</Color>
    
    
    
    
    

    <!-- Brushes (usados por controles) --> 

    <SolidColorBrush x:Key="Brush.Header"
                 Color="{StaticResource Color.Header_background}"/>

    <SolidColorBrush x:Key="Brush.Header2"
             Color="{StaticResource Color.Header2_background}"/>


    <SolidColorBrush x:Key="Brush.Sidebar"
                     Color="{StaticResource Color.Sidebar}"/>

    <SolidColorBrush x:Key="Brush.Text"
                     Color="{StaticResource Color.Text}"/>
    
    <!-- BRUSHES PARA BOTONES-->

    <SolidColorBrush x:Key="Brush.SidebarButton.Background"
                     Color="#016C35"/> 
    <!--017F3F-->

    <SolidColorBrush x:Key="Brush.SidebarButton.Hover"
                     Color="#017F3F"/>

    <SolidColorBrush x:Key="Brush.SidebarButton.Pressed"
                     Color="{StaticResource Color.Button_sidebar_pressed}"/>

    <SolidColorBrush x:Key="Brush.SidebarButton.Border"
                     Color="#014923"/>
    
    
    

    <!-- ========================================= -->
    <!-- TYPOGRAPHY                                -->
    <!-- ========================================= -->
    
    <!--BASE TEXT STYLE-->

    <Style x:Key="Text.Base" TargetType="TextBlock">
        
        <!--Font-->
        <Setter Property="FontFamily" Value="Segoe UI"/>
        
        <!--Default color-->

        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        
        <!--Base size-->
        <Setter Property="FontSize" Value="14"/>
        
        <!--Space between-->
        <Setter Property="Margin" Value="0"/>
        
        <!--Rendering mode-->

        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>


    </Style>
    <!--H1-->

    <Style x:Key="Text.H1"
       TargetType="TextBlock"
       BasedOn="{StaticResource Text.Base}">

        <Setter Property="FontSize" Value="28"/>

        <Setter Property="FontWeight" Value="Bold"/>


    </Style>

    <!--H2-->

    <Style x:Key="Text.H2"
       TargetType="TextBlock"
       BasedOn="{StaticResource Text.Base}">

        <Setter Property="FontSize" Value="22"/>

        <Setter Property="FontWeight" Value="SemiBold"/>


    </Style>

    <!--H3-->

    <Style x:Key="Text.Body"
       TargetType="TextBlock"
       BasedOn="{StaticResource Text.Base}">

        <Setter Property="FontSize" Value="28"/>


    </Style>




    <!-- ========================================= -->
    <!-- SIDEBAR MENU BUTTON STYLE                -->
    <!-- ========================================= -->


    <Style x:Key="SidebarMenuStyleButton"
           TargetType="Button">
        <Setter Property="Height" Value="55"/>

        <!--<Setter Property="Width" Value="10.6"/>-->
        

        <Setter Property="Padding" Value="12.0"/>

        <Setter Property="Background" Value="{StaticResource Brush.SidebarButton.Background}"/>

        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>

        <Setter Property="BorderBrush" Value="{StaticResource Brush.Text}"/>

        <Setter Property="BorderThickness" Value="1"/>
        
        <!--Text-->

        <Setter Property="FontSize" Value="24"/>
        <Setter Property="TextBlock.TextWrapping" Value="NoWrap"/>
        <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis"/>

        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        
        <Setter Property="HorizontalAlignment" Value="Stretch"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">

                        <ContentPresenter 
                            VerticalAlignment="Center"
                            Margin="5.0"/>

                        
                    </Border>

                    <ControlTemplate.Triggers>
                        
                        <!-- Hoover -->

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="border"
                                    Property="Background"
                                    Value="{StaticResource Brush.SidebarButton.Hover}"/>


                        </Trigger>
                        
                        
                        <!-- CLICK --><!--
                        <Trigger Property="IsPressed"
                                 Value="True">
                                 <Setter TargetName="border"
                                         Property="Background"
                                         Value="{StaticResource Brush.SidebarButton.Pressed}"/>
                        </Trigger>-->
                            


                    </ControlTemplate.Triggers>
                    
                </ControlTemplate>
                
            </Setter.Value>
            
        </Setter>














    </Style>






</ResourceDictionary>