<Application x:Class="Example.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             
             xmlns:views="clr-namespace:Example.Views"
             xmlns:vm="clr-namespace:Example.ViewModels"
             
              xmlns:converters="clr-namespace:Example.Converters">


    <!--StartupUri="MainWindow.xaml"//Se comenta esta linea debido a que ahora el 
    constructuro de main window requiere una inyeccion 
    de dependencia previa al incializarse  >-->

    <Application.Resources>

        <ResourceDictionary>

             <!--GLOBAL STYLES--> 
            <ResourceDictionary.MergedDictionaries>
              
                <ResourceDictionary Source="/Example;component/Resources/styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToCoilStatusConverter x:Key="BoolToCoilStatusConverter"/>
            <converters:ProcessStatusBrushConverter x:Key="StatusBrushConverter"/>

             <!--VIEW ↔ VIEWMODEL LINK--> 
                <DataTemplate DataType="{x:Type vm:InicializeScreenViewModel}">
                <views:InicializeScreen/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:FirstScreenViewModel}">
                    <views:FirstScreen/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:SecondScreenViewModel}">
                    <views:SecondScreen/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:ConfigurationScreenViewModel}">
                    <views:ConfigurationScreen/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:ConfigurationScreenEditViewModel}">
                       <views:ConfigurationScreenEdit/>
                   </DataTemplate>

                <DataTemplate DataType="{x:Type vm:InnitScreenViewModel}">
                    <views:InnitScreen/>
                </DataTemplate>



        </ResourceDictionary>
        
       

    </Application.Resources>

    
    
  

</Application>